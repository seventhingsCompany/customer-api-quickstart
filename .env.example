# Copy to .env and export these variables in your shell (see README).
SEVENTHINGS_INSTANCE_URL=https://your-instance.seventhings.com
SEVENTHINGS_TOKEN=
# Used only when SEVENTHINGS_TOKEN is empty:
SEVENTHINGS_USERNAME=
SEVENTHINGS_PASSWORD=
SEVENTHINGS_CLIENT_ID=
# Optional substring filter for hello and export; set both or neither:
SEVENTHINGS_FILTER_FIELD=
SEVENTHINGS_FILTER_VALUE=
# Recipe inputs:
SEVENTHINGS_BARCODE=
SEVENTHINGS_OBJECT_UUID=
SEVENTHINGS_PAYLOAD_FILE=
SEVENTHINGS_FILE=
SEVENTHINGS_ATTACHMENT_FIELD=
# Optional for attach: link this already uploaded file instead of uploading SEVENTHINGS_FILE:
SEVENTHINGS_FILE_UUID=
